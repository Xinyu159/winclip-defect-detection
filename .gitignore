# 环境
.venv/
__pycache__/
*.pyc
.cache_alive

# 数据集与模型权重(大,可下载/可重建。用 data/* 而不是 data/,
# 才能给下面的冻结清单开一个例外 —— data/ 会把整个目录挡死,例外加不进去)
data/*
!data/dataset_manifest.json

# 特征缓存(3.2 G,可重建但要几小时。实体在 artifacts/,不进城)
artifacts/

# 可视化产物
*.html

# 运行期日志与进程文件(不是实验结果 —— 结果在 logs/*.json)
*.log
*.pid

# 参考文献与内部留痕(含第三方论文全文,不入公开仓库)
refs/
